# ================================================================
#  Yukye Design — ForgeDB 백엔드 연결 설정
# ----------------------------------------------------------------
#  ForgeDB 콘솔(https://forgedb.cloud) 에서 프로젝트를 생성하고
#  아래 세 값을 채우면 자동으로 라이브 모드로 동작합니다.
#  값이 비어 있거나 placeholder 면 자동으로 LOCAL 모드
#  (localStorage + 시드 데이터)로 동작합니다.
#
#  ⚠️ 이 파일은 예시입니다. 실제 값은 절대 커밋하지 마세요.
#     `.env` / `.env.local` 은 이미 .gitignore 에 등록되어 있습니다.
# ================================================================

# ForgeDB API URL (모든 프로젝트에서 동일 — 콘솔 도메인)
VITE_FORGEDB_URL=https://forgedb.cloud

# ForgeDB 프로젝트 ID (콘솔 → 프로젝트 설정 → General)
VITE_FORGEDB_PROJECT_ID=

# Anon (public) API Key (콘솔 → 프로젝트 설정 → API Keys → anon/public)
# ⚠️ service_role 키는 절대 여기에 넣지 마세요 — RLS 를 우회합니다.
VITE_FORGEDB_ANON_KEY=

# ------------------------------------------------------------
#  주의사항 / 함정
# ------------------------------------------------------------
# 1) 키 이름은 반드시 VITE_ 로 시작해야 합니다.   (Vite 기본 envPrefix)
#    다른 이름(예: FORGEDB_URL) 으로 쓰면 import.meta.env 에서
#    보이지 않아 항상 LOCAL 모드로만 동작합니다.
# 2) 값 뒤에 공백/따옴표/줄바꿈이 들어가면 forgeClient 의
#    trim() 이 제거하지만, 가능한 한 클린한 값만 적어주세요.
# 3) 모든 VITE_* 변수는 번들에 인라인되므로 anon(public) 키만
#    사용하고 service_role 키는 절대 넣지 마세요. 비밀 키가
#    꼭 필요하다면 Edge Function 으로 라우팅하세요.
# 4) forgeClient 는 placeholder 문자열(your_, placeholder,
#    example, change-me, ${...} 등) 도 "비어있음"으로 취급합니다.

# ------------------------------------------------------------
#  적용 후 해야 할 일
# ------------------------------------------------------------
# 1) 콘솔 SQL Editor 에서  supabase/schema.sql  실행
# 2) 콘솔 Authentication → Users 에서 관리자 계정 1개 생성
#      (예: admin@yukye.local / 안전한 비밀번호)
# 3) `npm run dev` 재시작 → `/admin` 사이드바 하단 표시기가
#      LOCAL  →  FORGEDB 로 바뀌고 "실시간 동기화" 문구가 보이면 성공
# 4) (옵션) 콘솔 SQL Editor 에서 다음 명령으로 라운드트립 확인:
#      select count(*) from public.quotes;
#    값이 0 이어도 정상 — 새 견적 1건을 등록하면 즉시 +1 됩니다.

# ------------------------------------------------------------
#  사이트 운영 도메인 (SEO canonical / og:url / sitemap 절대 URL)
# ------------------------------------------------------------
#  커스텀 도메인 (예: yukyu.kr) 을 연결한 후 그 값을 적어주세요.
#  비워두면 기본값(https://yukyu.kr) 으로 동작합니다.
#  형식: https:// 도메인 (끝에 / 없이)
#  예: VITE_PUBLIC_SITE_URL=https://yukyu.kr
VITE_PUBLIC_SITE_URL=
