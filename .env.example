# ================================================================
#  Yukye Design — ForgeDB 백엔드 연결 설정
#  https://forgedb.cloud 콘솔에서 프로젝트 생성 후 값을 채워주세요.
#  세 값이 모두 비어 있으면 자동으로 LOCAL 모드(localStorage + 시드)로 동작합니다.
# ================================================================

# ForgeDB 서버 URL (프로젝트별로 다르지 않음 — 콘솔 도메인 그대로)
VITE_FORGEDB_URL=https://forgedb.cloud

# ForgeDB 프로젝트 ID (콘솔 → 프로젝트 설정 → General)
VITE_FORGEDB_PROJECT_ID=

# Anon (public) API Key (콘솔 → 프로젝트 설정 → API Keys → anon/public)
# ⚠️ service_role 키는 절대 여기에 넣지 마세요 — RLS를 우회합니다.
VITE_FORGEDB_ANON_KEY=

# ------------------------------------------------------------
#  적용 후 해야 할 일
# ------------------------------------------------------------
# 1) 콘솔 SQL Editor 에서 `supabase/schema.sql` 내용 실행
# 2) 콘솔 Auth 탭에서 관리자 계정 1개 생성
#    (예: admin@yukye.local / 안전한 비밀번호)
# 3) `npm run dev` 재시작 → 관리자 콘솔 사이드바 표시기가
#    LOCAL → FORGEDB 로 바뀌면 성공
# ------------------------------------------------------------